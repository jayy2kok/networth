# Remote MongoDB URI, including the database name. Keep credentials in .env only.
MONGO_URI=
# Optional separate read-only URI for the MCP service.
MCP_MONGO_URI=
KITE_API_KEY=
KITE_API_SECRET=

# News Analyzer: OpenAI-compatible API base URL (without /chat/completions).
# Leave the URL and key empty to disable AI analysis.
NEWS_AI_BASE_URL=
NEWS_AI_MODEL=gpt-4o-mini
NEWS_AI_API_KEY=